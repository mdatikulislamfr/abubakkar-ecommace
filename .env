URL="http://localhost:4000"
APP_NAME="Express App"
NODE_ENV=production
APP_KEY =your-app-key-change-this-in-production
# Server Configuration
PORT=4000
HOST=localhost
DEBUG=false
# Request Configuration
JSON_LIMIT=1mb
URLENCODED_LIMIT=5mb
REQUEST_TIMEOUT=30000

# CORS Configuration
# Example: http://localhost:3000,https://example.com,https://app.example.com
CORS_ORIGIN=http://localhost:3001,http://localhost:3000
CORS_CREDENTIALS=true
CORS_ENABLED=true
CORS_MAX_AGE=3600

# Session Configuration
SESSION_SECRET=your-secret-key-change-this-in-production
SESSION_TIMEOUT=3600000

# Cache Configuration
CACHE_DRIVER=memory
CACHE_TTL=3600

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=production
DB_USER=root
DB_PASSWORD=
DB_TIMEZONE=UTC
DB_CHARSET=utf8mb4



# Database Connection Pool
DB_CONNECTION_LIMIT=10
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# Database Debug & Performance
DB_DEBUG=false
DB_SLOW_QUERY_LOG=1000

# Migrations & Seeders
DB_MIGRATIONS_DIR=database/migrations
DB_MIGRATIONS_TABLE=migrations
DB_SEEDS_DIR=database/seeders

# Backup Configuration
DB_BACKUP_ENABLED=false
DB_BACKUP_SCHEDULE=0 2 * * *
DB_BACKUP_DIR=storage/backups
DB_BACKUP_RETENTION=30

# Replication (Read Replicas)
DB_REPLICATION_ENABLED=false
DB_READ_HOST=localhost
DB_READ_PORT=3306

# Authentication Configuration
AUTH_GUARD=api
AUTH_PROVIDER=jwt
JWT_SECRET=your-jwt-secret-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
JWT_AUDIENCE=api
HASH_DRIVER=bcrypt
BCRYPT_ROUNDS=10

# Logging Configuration
LOG_LEVEL=info
LOG_PATH=storage/logs

# File Upload Configuration
UPLOAD_DIR=storage/uploads
UPLOAD_MAX_SIZE=5242880

# mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="Express App"