{
  "name": "express-app",
  "version": "1.0.0",
  "description": "this is express-app",
  "main": "server.js",
  "directories": {
    "test": "tests"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "migration:make": "tsx ./node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:make",
    "migrate": "knex --knexfile knexfile.ts migrate:latest",
    "migrate:rollback": "knex --knexfile knexfile.ts migrate:rollback",
    "migrate:latest": "knex --knexfile knexfile.ts migrate:latest",
    "migrate:list": "tsx ./node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:list"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "knex": "^3.3.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "crypto": "^1.0.1",
    "express": "^5.2.1",
    "express-application-framework": "^1.0.1",
    "express-auth-framework": "^1.0.1",
    "express-mysql-framework": "^1.0.6",
    "express-route-framework": "^1.0.5",
    "mysql2": "^3.23.3",
    "nanoid": "^6.0.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "sharp": "^0.35.3",
    "slugify": "^1.6.9"
  }
}
